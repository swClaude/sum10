{
  "expo": {
    "name": "SUM10 パズル",
    "slug": "sum10",
    "scheme": "sum10",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.souwer2.sum10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.game-center": true
      }
    },
    "android": {
      "package": "com.souwer2.sum10",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-splash-screen",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "お客様に合った広告を表示するために、端末の識別子を使用します。許可しなくてもアプリはすべて利用できます。"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-6542116879590958~2927677472",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1be87b3b-95de-4c23-8780-f179901fbbef"
      }
    }
  }
}
